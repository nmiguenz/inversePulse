# ---- Frontend (expuestas al browser) ----
# OJO: es el "Project URL" de Settings → API (termina en .supabase.co),
# NO la URL del panel (https://supabase.com/dashboard/project/...).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
VITE_VAPID_PUBLIC_KEY=BN...

